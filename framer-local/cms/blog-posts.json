    {
      "_id": "Njk60CeFJ",
      "_slug": "how-we-think-about-food",
      "_draft": false,
      "Title": {
        "type": "string",
        "value": "Machakos People's Park",
        "valueByLocale": {}
      },
      "Excerpt": {
        "type": "formattedText",
        "value": "<p dir=\"auto\">World-class recreation in Machakos town — zip-lines, boat rides and family fun just 2km away.</p>",
        "valueByLocale": {}
      },
      "Body": {
        "type": "formattedText",
        "value": "<h3 dir=\"auto\">In the Heart of Machakos</h3><p dir=\"auto\">Machakos People's Park features beautifully lit walkways and arches, dancing fountains, a 300m zip-line, camel and horse riding, boat rides, archery and a children's playground. Free entry.</p><h3 dir=\"auto\">From the Hotel</h3><p dir=\"auto\">The park is just 2km from Tea Tot Hotels — an easy outing for families and groups staying with us.</p>",
        "valueByLocale": {}
      },
      "Author": {
        "type": "string",
        "value": "Tea Tot Hotels",
        "valueByLocale": {}
      },
