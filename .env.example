# Local / example only. On cPanel, set these in Setup Node.js App → Environment variables.
# Never commit real secrets. Never FTP a .env into public_html/{development,production}.
# Develop and production are separate Node apps — their env vars do not overwrite each other.

# Google Maps Embed API key (optional — falls back to address + directions link)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# SMTP configuration for contact + booking forms (runtime — cPanel Node app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=info@teatot.co.ke

# Site URL (sitemap, OG, canonical). Also set in GitHub Actions for the matching branch build:
# develop → https://dev.teatot.co.ke  (.github/workflows/deploy-develop.yml)
# main    → https://www.teatot.co.ke  (.github/workflows/deploy-production.yml)
NEXT_PUBLIC_SITE_URL=https://dev.teatot.co.ke
