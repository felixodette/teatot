    {
      "_id": "Vx8TEh8J7",
      "_slug": "art-of-a-good-hotel-stay",
      "_draft": false,
      "Title": {
        "type": "string",
        "value": "Kyamwilu Gravity Hill",
        "valueByLocale": {}
      },
      "Excerpt": {
        "type": "formattedText",
        "value": "<p dir=\"auto\">Where nature defies gravity — a mysterious optical phenomenon unique to Machakos.</p>",
        "valueByLocale": {}
      },
      "Body": {
        "type": "formattedText",
        "value": "<h3 dir=\"auto\">Antigravity Site</h3><p dir=\"auto\">Officially certified by Machakos Tourism as the Kyamwilu Antigravity Site — water flows uphill and cars roll without power. A must-visit attraction approximately 15km from the hotel.</p><h3 dir=\"auto\">Plan Your Visit</h3><p dir=\"auto\">Ask our front desk to arrange a trip to Kyamwilu and other Machakos highlights during your stay.</p>",
        "valueByLocale": {}
      },
      "Author": {
