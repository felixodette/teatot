# Google Maps Embed API key (optional — falls back to address + directions link)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# SMTP configuration for contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=info@thehotel.com

# Site URL (used for sitemap, OG tags, canonical URLs)
# develop → https://dev.teatot.co.ke
# main    → https://www.teatot.co.ke
NEXT_PUBLIC_SITE_URL=https://dev.teatot.co.ke
